# Copy to .env and fill in. Never commit .env.

# Free API key from https://console.mistral.ai (Experiment plan)
MISTRAL_API_KEY=

# Connection the app uses. Use the read-only bookstore_reader role in production.
# Supabase pooler format: postgresql://bookstore_reader.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Only needed to run scripts/setup_database.py (Supabase "postgres" user connection string).
ADMIN_DATABASE_URL=
READONLY_DB_PASSWORD=

# Optional overrides
# MISTRAL_CHAT_MODEL=codestral-latest        # writes the SQL
# MISTRAL_ANSWER_MODEL=ministral-14b-latest  # writes the plain-English answer
# MISTRAL_EMBEDDING_MODEL=mistral-embed
